diff --git a/src/utils/quota/antigravityVerification.ts b/src/utils/quota/antigravityVerification.ts
new file mode 100644
index 0000000..0a6af5a
--- /dev/null
+++ b/src/utils/quota/antigravityVerification.ts
@@ -0,0 +1,41 @@
+import { isRecord } from '@/utils/helpers';
+
+export class AntigravityVerificationError extends Error {
+  readonly status = 403;
+
+  constructor(message: string, readonly verificationUrl: string) {
+    super(message);
+  }
+}
+
+export function getAntigravityVerificationUrl(body: unknown): string | undefined {
+  if (!isRecord(body) || !isRecord(body.error) || !Array.isArray(body.error.details)) {
+    return undefined;
+  }
+
+  const details = body.error.details.filter(isRecord);
+  const validation = details.find((detail) => detail.reason === 'VALIDATION_REQUIRED');
+  if (!validation) return undefined;
+
+  const urls = new Set<string>();
+  const addUrl = (value: unknown) => {
+    if (
+      typeof value === 'string' &&
+      /^https:\/\/accounts\.google\.com\/(?:v3\/)?signin\/continue(?:\?[^#\s]+)?$/.test(value)
+    ) {
+      urls.add(value);
+    }
+  };
+
+  if (isRecord(validation.metadata)) {
+    addUrl(validation.metadata.validation_url);
+    addUrl(validation.metadata.validationUrl);
+  }
+  for (const detail of details) {
+    if (detail['@type'] !== 'type.googleapis.com/google.rpc.Help' || !Array.isArray(detail.links)) {
+      continue;
+    }
+    for (const link of detail.links.filter(isRecord)) addUrl(link.url);
+  }
+  return urls.size === 1 ? urls.values().next().value : undefined;
+}
